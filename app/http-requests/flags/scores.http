### Get high scores (public)
GET {{url}}/api/flags/scores
Content-Type: application/json

### Submit game results
POST {{url}}/api/flags/scores
Authorization: Bearer {{0xNTK_token}}
Content-Type: application/json

{
  "score": 850,
  "date": "2026-01-02T15:30:00Z",
  "answers": [
    {
      "flagCode": "au",
      "correct": true,
      "answerDateTime": 1735834200000,
      "time": 2500,
      "answerOptions": ["au", "nz", "fj", "pg"],
      "sessionTimer" : 100
    },
    {
      "flagCode": "de",
      "correct": true,
      "answerDateTime": 1735834202500,
      "time": 1800,
      "answerOptions": ["de", "at", "ch", "nl"],
      "sessionTimer" : 100
    },
    {
      "flagCode": "fr",
      "correct": false,
      "answerDateTime": 1735834204300,
      "time": 3200,
      "answerOptions": ["fr", "it", "es", "pt"],
      "sessionTimer" : 100
    }
  ]
}

